# Nebius Token Factory — get your key at tokenfactory.nebius.com
NEBIUS_API_KEY=your_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Slack — create a Slack app at api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_APP_TOKEN=xapp-your-token
SLACK_SIGNING_SECRET=your-signing-secret

# CoS channel — the Slack channel your Chief of Staff posts to
COS_SLACK_CHANNEL=#anywhere-stack

# GitHub — for reading repo state (read:repo scope)
GITHUB_TOKEN=ghp_your_token
GITHUB_ORG=your-github-username
